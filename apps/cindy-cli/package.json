{
  "name": "@cindy/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cindy terminal client for remote and shared Agents",
  "bin": {
    "cindy": "dist/cindy.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@cindy/anthropic-compat-proxy": "workspace:*",
    "@cindy/auth-client": "workspace:*",
    "@cindy/browser-control-runtime": "workspace:*",
    "@cindy/device-link": "workspace:*",
    "@cindy/maker-core": "workspace:*",
    "@cindy/maker-shared": "workspace:*",
    "@cindy/model-providers": "workspace:*",
    "@cindy/remote-agent-host": "workspace:*",
    "@napi-rs/keyring": "2.1.2",
    "ink": "7.1.1",
    "react": "19.2.3",
    "undici": "^8.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.28.1",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}

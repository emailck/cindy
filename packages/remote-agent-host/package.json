    "./host/linkActivity": "./src/host/linkActivity.ts",
    "./host/sessionIdentity": "./src/host/sessionIdentity.ts",
    "./host/guestIsolation": "./src/host/guestIsolation.ts",
    "./host/guestUsage": "./src/host/guestUsage.ts",

{
  "name": "@cindy/host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node host for Cindy remote Agent providers",
  "bin": { "cindy-host": "dist/cli.cjs" },
  "exports": { ".": "./src/cli.ts", "./config": "./src/config.ts", "./lifecycle": "./src/lifecycle.ts" },
  "engines": { "node": ">=22.19" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@cindy/auth-client": "workspace:*",
    "@cindy/device-link": "workspace:*",
    "@cindy/maker-core": "workspace:*",
    "@cindy/model-providers": "workspace:*",
    "@cindy/remote-agent-host": "workspace:*",
    "@napi-rs/keyring": "2.1.2",
    "ws": "^8.18.0",
    "@cindy/anthropic-compat-proxy": "workspace:*",
    "better-sqlite3": "12.11.1",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
